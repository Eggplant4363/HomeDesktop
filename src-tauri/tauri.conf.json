{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HomeDesktop",
  "version": "0.2.1",
  "identifier": "dev.homedesktop.app",
  "build": {
    "beforeDevCommand": "node scripts/run-pnpm.cjs run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/run-pnpm.cjs run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HomeDesktop",
        "width": 1024,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/WebView2Loader.dll",
      "resources/plugins/system-apps",
      "resources/plugins/clock",
      "resources/plugins/weather",
      "resources/plugins/calendar",
      "resources/plugins/sysmonitor",
      "resources/plugins/todo"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
