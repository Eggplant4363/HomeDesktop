{
  "id": "dev.homedesktop.homeassistant",
  "name": "HomeAssistant",
  "version": "0.1.0",
  "type": "widget",
  "emoji": "🏠",
  "widgetComponent": "homeassistant",
  "sizes": [
    { "w": 3, "h": 2 },
    { "w": 4, "h": 2 },
    { "w": 4, "h": 3 }
  ],
  "settings": [
    {
      "key": "url",
      "label": "HomeAssistant 地址",
      "type": "text",
      "default": "http://192.168.1.100:8123"
    },
    {
      "key": "token",
      "label": "长期访问令牌",
      "type": "text",
      "default": ""
    },
    {
      "key": "entities",
      "label": "实体 ID（逗号分隔）",
      "type": "text",
      "default": "light.bedroom,switch.office,sensor.temperature"
    }
  ],
  "actions": []
}
