{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "HomeDesktop 主窗口默认能力",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-hide",
    "global-shortcut:default",
    "dialog:default",
    "autostart:default",
    "notification:default"
  ]
}
